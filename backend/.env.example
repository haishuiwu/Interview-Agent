# 通义千问 DashScope API Key（必填）
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 模型配置
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3

# RAG 重排策略（可选）：cross-encoder（默认，专用重排模型 gte-rerank）/ llm（LLM 全量重排）/ none（不重排）
RERANKER_TYPE=cross-encoder
# cross-encoder 使用的重排模型（RERANKER_TYPE=cross-encoder 时生效）
RERANK_MODEL=gte-rerank-v2

# Milvus 向量数据库
MILVUS_ADDR=localhost:19530

# Redis
REDIS_ADDR=localhost:36379
REDIS_PASSWORD=
REDIS_DB=0

# MySQL
MYSQL_DSN=root:interview@tcp(localhost:33306)/interview_agent?charset=utf8mb4&parseTime=True&loc=Local

# GitHub（可选，用于复习计划推荐真实开源项目）
GITHUB_TOKEN=

# JWT 认证密钥（生产环境请替换为随机字符串）
JWT_SECRET=student-coach-default-secret

# 语音学习互动全局 feature flag（安全默认关闭；关闭时文字训练不受影响）
# 灰度建议：先设置 SPEECH_ENABLED=true、SPEECH_ASR_ENABLED=false，仅开放 TTS；观察稳定后再开启 ASR。
SPEECH_ENABLED=false
SPEECH_TTS_ENABLED=true
SPEECH_ASR_ENABLED=true

# DashScope TTS（API Key 复用顶部的 DASHSCOPE_API_KEY）
DASHSCOPE_TTS_MODEL=qwen3-tts-flash
DASHSCOPE_TTS_VOICE=Cherry
DASHSCOPE_TTS_LANGUAGE=Auto
DASHSCOPE_TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# DashScope ASR
DASHSCOPE_ASR_REALTIME_MODEL=qwen3-asr-flash-realtime
DASHSCOPE_ASR_FALLBACK_MODEL=qwen3-asr-flash
DASHSCOPE_ASR_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
DASHSCOPE_ASR_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 语音输入、并发和超时限制
SPEECH_MAX_TTS_CHARS=500
SPEECH_MAX_TTS_AUDIO_BYTES=10485760
SPEECH_MAX_ANSWER_SECONDS=180
SPEECH_MAX_CONCURRENT_TTS=20
SPEECH_MAX_CONCURRENT_ASR=20
SPEECH_TTS_TIMEOUT_SECONDS=15
SPEECH_ASR_CONNECT_TIMEOUT_SECONDS=5
SPEECH_ASR_FINAL_TIMEOUT_SECONDS=8
SPEECH_ASR_FALLBACK_TIMEOUT_SECONDS=45

# 语音 HTTP/ASR WebSocket 的精确 Origin 白名单；多个值使用英文逗号分隔，不支持通配符或路径。
# 生产环境必须替换为实际 HTTPS 前端域名。
WEB_ALLOWED_ORIGINS=http://localhost:5173
